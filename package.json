{
  "name": "sope-workspace",
  "version": "0.6.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "bindings/js",
    "tui"
  ],
  "scripts": {
    "build:native": "cmake -S . -B build -DCMAKE_BUILD_TYPE=Debug && cmake --build build",
    "test:native": "ctest --test-dir build --output-on-failure",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p .",
    "tui": "bun tui/src/main.ts",
    "demo": "bun scripts/demo.ts",
    "release": "bash scripts/release.sh"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.6.0"
  }
}
